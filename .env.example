# Live research needs either provider. OpenAI is preferred when both are configured.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-5-nano
GOOGLE_MODEL=gemini-2.5-flash

# Optional document ingestion and retrieval also require an OpenAI embedding key.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=research-assistant
PINECONE_NAMESPACE=research-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
